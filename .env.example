# Copy this file to .env. Credentials stay on the Node backend, never the browser.
# Paste the PostgreSQL connection string from Neon's Connect dialog.
DATABASE_URL=

# Same database + same ID means the same ledger. Keep this stable.
CLOUD_LEDGER_ID=personal

# Saves enqueue sync after 250ms. This interval checks for cloud changes/retries.
# Shorter intervals can keep Neon compute awake and consume more free allowance.
CLOUD_SYNC_INTERVAL_MS=60000
